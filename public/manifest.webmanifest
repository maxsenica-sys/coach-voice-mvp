{
  "name": "CoachVoice",
  "short_name": "CoachVoice",
  "description": "AI-powered voice coaching platform for athletes and coaches",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "theme_color": "#1F2421",
  "background_color": "#1F2421",
  "categories": ["sports", "health", "education"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "screenshots": [],
  "shortcuts": [
    {
      "name": "New Session",
      "url": "/dashboard?tab=sessions",
      "description": "Start a new coaching session"
    },
    {
      "name": "Messages",
      "url": "/dashboard?tab=messages",
      "description": "View athlete messages"
    }
  ]
}
